#!/bin/sh
# 本地提交门禁：机械执行 AGENTS.md“提交与测试”约定。
#
# 启用方式（仓库根目录执行一次）：
#   git config core.hooksPath .githooks
#
# 行为：暂存区包含 web/ 改动时，运行 lint 与完整检查（测试 + 类型检查 +
# 生产构建）；只改文档时跳过，避免无谓等待。任一步失败即中止提交。

set -e

staged_web=$(git diff --cached --name-only --diff-filter=ACMR -- web | head -1)

if [ -z "$staged_web" ]; then
  echo "pre-commit：本次提交未改动 web/，跳过 Web 门禁。"
  exit 0
fi

if [ ! -d web/node_modules ]; then
  echo "pre-commit：缺少 web/node_modules。" >&2
  echo "  请先在 web/ 目录执行 npm ci，再重新提交。" >&2
  exit 1
fi

echo "pre-commit：检测到 web/ 改动，开始门禁检查。"

echo "pre-commit：[1/2] npm run lint"
if ! (cd web && npm run --silent lint); then
  echo "pre-commit：lint 未通过，已中止提交。" >&2
  exit 1
fi

echo "pre-commit：[2/2] npm run check（测试 + 类型检查 + 生产构建）"
if ! (cd web && npm run --silent check); then
  echo "pre-commit：完整检查未通过，已中止提交。" >&2
  echo "  请修复真实问题后重新提交，不要跳过或放宽断言。" >&2
  exit 1
fi

echo "pre-commit：全部门禁通过。"
